# Runtime configuration for den-reel. Every variable is optional. The binary reads the process
# environment only (no .env loader): export these for `cargo run`; on the homelab they come from the
# den repo's deploy/ env files. PLAY_SECRET(S_PREV), CONFIG_KEY(S_PREV), METRICS_TOKEN and the two
# upstream keys are secrets.

# PORT=8092

# Where trailers, yt-dlp's player cache and the parked resolve cache live (the image sets /cache).
# Must be den-reel's alone: any top-level file that is not <youtube_id>.mp4 is deleted as scratch.
# CACHE_DIR=$TMPDIR/den-reel-cache

# LRU cap on the cache in bytes (default 4 GB; below 256 MB falls back to the default).
# CACHE_MAX_BYTES=4294967296
# Evict a trailer this many seconds after it was last served (default 14 days; 0 = size cap only).
# CACHE_TTL_SECS=1209600

# Tallest rendition to fetch; avc1 tops out at 1080 on YouTube (below 144 falls back to the default).
# MAX_HEIGHT=1080

# Binaries, when they are not on PATH under these names.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# MP4BOX_PATH=MP4Box

# Bake a clap (clean aperture) box so AVPlayer crops a detected letterbox; 0/false/off/no disables.
# CLAP=1

# Pin YouTube innertube client(s), comma-separated. Leave unset (yt-dlp chooses); a stopgap only.
# YTDLP_PLAYER_CLIENTS=

# Sealed config-in-URL: base64 32-byte X25519 private key, and prior keys (comma-separated) during
# rotation. Unset = sealing disabled, plaintext install URLs still work. Back the key up. Rotation is
# NOT revocation: links sealed to a prior key keep opening. Revoke with the two below instead.
# CONFIG_KEY=
# CONFIG_KEYS_PREV=

# Install revocation. Every /configure link carries an install id (iid) and the epoch it was built
# in (ep). REVOKED_INSTALLS refuses installs by id, comma-separated. Raising CONFIG_EPOCH refuses
# every link stamped below it (links from before ids existed count as 0); new links get the new
# epoch. Unset / 0 = nothing refused. /play and /crop URLs carry no config and are not affected.
# REVOKED_INSTALLS=
# CONFIG_EPOCH=0

# Sign /play + /crop URLs (any string), and prior secrets still accepted while rotating. On an
# existing install set PLAY_SIGNING_GRACE_UNTIL with it: clients cache /meta for 7 days.
# PLAY_SECRET=
# PLAY_SECRETS_PREV=
# Until this RFC 3339 moment an UNTAGGED /play or /crop is still served (a wrong tag never is). Set it
# to now + 7 days alongside PLAY_SECRET, and remove it once it has passed. Ignored without PLAY_SECRET.
# PLAY_SIGNING_GRACE_UNTIL=2026-09-17T12:00:00Z

# Bearer token for GET /metrics (Prometheus text). Unset ⇒ the route answers 404.
# METRICS_TOKEN=

# One stderr line per response, `<METHOD> <path> <status> <ms>ms`, with the query string dropped and
# any config segment written as <config>. Unset, empty or 0 ⇒ off.
# LOG_REQUESTS=0

# Legacy server-side discovery keys, used only when a request carries no per-install config.
# TMDB_KEY=
# KINOCHECK_KEY=

# Force the base of the play URLs /meta hands out. Unset follows the request's Host /
# X-Forwarded-Host / X-Forwarded-Proto.
# PUBLIC_BASE_URL=http://den.lan:8092
